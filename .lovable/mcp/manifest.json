{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "troopconnect",
      "version": "0.1.0",
      "title": "TroopConnect"
    },
    "tools": [
      {
        "name": "list_players",
        "title": "List troopers",
        "description": "List troopers (players) with their spirit animal, optionally filtered by troop name.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "troop": {
              "description": "Troop name to filter by (case-insensitive).",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_game_results",
        "title": "List finished games",
        "description": "List finished games with date, rounds and each player's final score and rank, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "game": {
              "description": "Game name to filter by, e.g. Poker.",
              "type": "string"
            },
            "limit": {
              "description": "Max games to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_leaderboard",
        "title": "Get leaderboard",
        "description": "Wins, games played and total points per player, optionally for one game.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "game": {
              "description": "Game name to filter by.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
